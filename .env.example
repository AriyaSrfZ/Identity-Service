# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=sqlite:///./data/identity.db

# The platform-level super-admin, bootstrapped on first startup. This
# account manages tenants (not any one tenant's data).
PLATFORM_ADMIN_USERNAME=platform_admin
PLATFORM_ADMIN_PASSWORD=change_this_password

# Trusted server-to-server key for provisioning tenants without a human
# logging in (e.g. another app auto-creating a tenant for a new customer).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PLATFORM_API_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=identity-service
